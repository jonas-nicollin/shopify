{%- comment -%}
  Existing badge contract: available products with custom.sub_collection = One of a kind.
  Keep the stock/sale badge branches in card-product; this optional badge complements them.
{%- endcomment -%}
{%- assign sub_collection = product.metafields.custom.sub_collection.value | strip -%}
{%- if product.available and sub_collection == 'One of a kind' -%}
  <div class="card__badge top left">
    <span class="badge badge--one-of-a-kind color-{{ settings.unique_badge_color_scheme | default: 'scheme-1' }}">One of a kind</span>
  </div>
{%- endif -%}
