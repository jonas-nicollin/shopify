{%- comment -%}
  Product-group navigation. Pass product and block from the main-product block case.
  Contract: custom.product_group metaobject -> products, sort, display.
  Each member is a separate product; this does not change Shopify variants.
{%- endcomment -%}
{%- liquid
  assign group = product.metafields.custom.product_group.value
  assign members = group.products.value
  assign display_mode = group.display.value
  if group.sort.value == 'Alphabetical'
    assign members = members | sort: 'title'
  endif
-%}
{%- if members != blank -%}
  <div class="product-group-variants" {{ block.shopify_attributes }}>
    <p class="product-group-variants__label">{{ block.settings.label | default: 'Colors' | escape }}</p>
    <ul class="product-group-variants__list" role="list">
      {%- for member in members -%}
        {%- if member != blank and member.url != blank -%}
          <li class="product-group-variants__item">
            <a href="{{ member.url }}" class="product-group-variants__link{% if member.id == product.id %} is-active{% endif %}" aria-label="{{ member.title | escape }}"{% if member.id == product.id %} aria-current="page"{% endif %}>
              {%- if display_mode == 'Image' and member.featured_image -%}
                {{ member.featured_image | image_url: width: 180 | image_tag: widths: '60,120,180', sizes: '60px', width: 60, height: 60, loading: 'lazy', alt: '' }}
                <span class="product-group-variants__tooltip" aria-hidden="true">{{ member.title | escape }}</span>
              {%- else -%}
                <span class="product-group-variants__text">{{ member.title | escape }}</span>
              {%- endif -%}
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}
{% stylesheet %}
.product-group-variants {color:rgb(var(--color-foreground))}
.product-group-variants__label {font-size:1.2rem}
.product-group-variants__list {display:flex;flex-wrap:wrap;gap:.25rem;list-style:none;padding:0;margin:0}
.product-group-variants__item {margin:0}
.product-group-variants__link {display:block;position:relative;padding:2px;border:1px solid transparent;color:inherit;text-decoration:none;transition:border-color 200ms ease}
.product-group-variants__link:is(:hover,.is-active) {border-color:rgb(var(--color-foreground))}
.product-group-variants__link:focus-visible {outline:2px solid rgb(var(--color-foreground));outline-offset:2px}
@media(prefers-reduced-motion:reduce){.product-group-variants__link {transition:none}}
.product-group-variants__link img {display:block;width:60px;height:60px;object-fit:cover}
.product-group-variants__text {display:grid;place-items:center;min-width:60px;min-height:60px;padding:.5rem;max-width:20rem;text-align:center;font-size:1.2rem;overflow-wrap:anywhere}
.product-group-variants__tooltip {position:absolute;bottom:calc(100% + 6px);left:50%;transform:translateX(-50%);z-index:2;padding:4px 6px;background:rgb(var(--color-background));color:rgb(var(--color-foreground));font-size:1.2rem;line-height:1;white-space:nowrap;pointer-events:none;opacity:0;transition:opacity 150ms ease}
.product-group-variants__link:is(:hover,:focus-visible) .product-group-variants__tooltip {opacity:1}
@media(prefers-reduced-motion:reduce){.product-group-variants__tooltip {transition:none}}
{% endstylesheet %}
