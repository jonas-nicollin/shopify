{%- comment -%}
  Shared gallery rendered directly inside card-product's card__media.
  Pass product, lazy_load, desktop_columns, mobile_columns and gallery_id.
  Controls are siblings of the padded image gallery, so card padding never moves the carets inward.
{%- endcomment -%}
{% liquid
  assign images = product.metafields.custom.card_images.value | where: 'media_type', 'image'
  if images == blank
    assign images = product.images
  endif
  assign count = images.size | at_most: 3
  assign loading = 'lazy'
  if lazy_load == false
    assign loading = 'eager'
  endif
  assign cols = desktop_columns | default: 4
  assign desktop_percent = 100.0 | divided_by: cols
%}
{%- capture image_sizes -%}(min-width: 990px) {{ desktop_percent }}vw, calc(100vw / {{ mobile_columns | default: 2 }}){%- endcapture -%}
{% if count > 1 %}
  <div class="product-card-gallery__controls" hidden>
    <button type="button" data-step="-1" aria-controls="{{ gallery_id }}" aria-label="{{ 'sections.slideshow.previous_slideshow' | t | escape }}">{{ 'icon-caret.svg' | inline_asset_content }}</button>
    <button type="button" data-step="1" aria-controls="{{ gallery_id }}" aria-label="{{ 'sections.slideshow.next_slideshow' | t | escape }}">{{ 'icon-caret.svg' | inline_asset_content }}</button>
  </div>
{% endif %}
<product-card-gallery id="{{ gallery_id }}" class="product-card-gallery">
  <a class="product-card-gallery__link" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
    {% for item in images limit: 3 %}
      {% assign photo = item.preview_image | default: item %}
      {% if forloop.first %}
        {{ photo | image_url: width: 1200 | image_tag: widths: '180, 360, 540, 720, 960, 1200', sizes: image_sizes, loading: loading }}
      {% else %}
        <template>{{ photo | image_url: width: 1200 | image_tag: widths: '180, 360, 540, 720, 960, 1200', sizes: image_sizes }}</template>
      {% endif %}
    {% endfor %}
  </a>
</product-card-gallery>
{% if count > 1 %}
  <div class="product-card-gallery__scrollbar" style="--gallery-count:{{ count }};--gallery-index:0" hidden>
    <span class="product-card-gallery__thumb" aria-hidden="true"></span>
    <input type="range" min="1" max="{{ count }}" step="1" value="1" aria-controls="{{ gallery_id }}" aria-label="{{ 'sections.slideshow.load_slide' | t | escape }}" aria-valuetext="1 / {{ count }}">
  </div>
{% endif %}
{% stylesheet %}
.card .card__inner .card__media:has(> .product-card-gallery) {margin:0;width:100%;z-index:2}
.card__inner:has(.product-card-gallery) > .card__content {z-index:3;pointer-events:none}
.card-wrapper:has(.product-card-gallery) .card__heading a::after {content:none}
.product-card-gallery {display:block;position:absolute;inset:var(--image-padding,0px);touch-action:pan-y pinch-zoom}
.product-card-gallery__link {display:block;width:100%;height:100%}
.product-card-gallery__link img {display:block;position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity 550ms cubic-bezier(.2,.65,.3,1)}
.product-card-gallery__link img:first-of-type,.product-card-gallery__link img.is-active {opacity:1}
.product-card-gallery__link img.is-inactive {opacity:0}
@media(prefers-reduced-motion:reduce){.product-card-gallery__link img {transition:none}}
.product-card-gallery__controls {position:absolute;inset:0;z-index:2;pointer-events:none;display:flex;align-items:center;justify-content:space-between;opacity:0;transition:opacity 220ms ease}
.product-card-gallery__controls[hidden] {display:none}
@media(hover:hover) and (pointer:fine){.card-wrapper:is(:hover,:focus-within) .product-card-gallery__controls {opacity:1}}
@media(hover:none),(pointer:coarse),(max-width:749px){.product-card-gallery__controls {display:none}}
@media(prefers-reduced-motion:reduce){.product-card-gallery__controls {transition:none}}
.product-card-gallery__controls button {pointer-events:auto;display:grid;place-items:center;width:44px;height:44px;padding:0;border:0;background:transparent;color:rgb(var(--color-foreground));cursor:pointer}
.product-card-gallery__controls svg {display:block;width:10px;height:6px;transform:rotate(-90deg)}
.product-card-gallery__controls [data-step="-1"] svg {transform:rotate(90deg)}
.product-card-gallery__scrollbar {position:absolute;z-index:3;inset-inline:var(--image-padding,0px);bottom:var(--image-padding,0px);height:2px;background:rgba(var(--color-foreground),.15);opacity:1;transition:opacity 220ms ease}
.product-card-gallery__scrollbar[hidden] {display:none}
@media(hover:hover) and (pointer:fine) and (min-width:750px){
  .product-card-gallery__scrollbar {opacity:0}
  .card-wrapper:is(:hover,:focus-within) .product-card-gallery__scrollbar {opacity:1}
}
@media(prefers-reduced-motion:reduce){.product-card-gallery__scrollbar {transition:none}}
.product-card-gallery__thumb {display:block;height:100%;width:calc(100% / var(--gallery-count));background:rgb(var(--color-foreground));transform:translateX(calc(var(--gallery-index) * 100%));transition:transform 350ms ease}
@media(prefers-reduced-motion:reduce){.product-card-gallery__thumb {transition:none}}
.product-card-gallery__scrollbar input {position:absolute;inset-inline:0;bottom:0;width:100%;height:24px;margin:0;opacity:0;cursor:ew-resize;touch-action:pan-x}
.product-card-gallery__scrollbar:focus-within {outline:2px solid rgb(var(--color-foreground));outline-offset:3px}
{% endstylesheet %}
{% javascript %}
if (!customElements.get('product-card-gallery')) {
  customElements.define('product-card-gallery', class extends HTMLElement {
    connectedCallback() { this.frame=requestAnimationFrame(()=>this.mount()); }
    disconnectedCallback() { cancelAnimationFrame(this.frame);this.events?.abort(); }
    mount() {
      const media=this.parentElement;
      const controls=media.querySelector('.product-card-gallery__controls');
      const scrollbar=media.querySelector('.product-card-gallery__scrollbar');
      const range=scrollbar?.querySelector('input');
      const link=this.querySelector('a');
      if(!link||!controls)return;
      const templates=[...link.querySelectorAll('template')];
      link.querySelectorAll('img[data-extra-view]').forEach(image=>image.remove());
      const slides=[link.querySelector('img')],count=templates.length+1;
      let current=0,version=0,start,suppressUntil=0;
      this.events=new AbortController();
      const on=(element,event,handler)=>element?.addEventListener(event,handler,{signal:this.events.signal});
      const show=async index=>{
        index=(index+count)%count;
        const request=++version;
        if(!slides[index]){
          slides[index]=templates[index-1].content.firstElementChild.cloneNode(true);
          slides[index].dataset.extraView='';
          // Requested gallery slides should load now, independently of native cover lazy loading.
          slides[index].loading='eager';
          link.append(slides[index]);
        }
        current=index;
        const image=slides[index];
        if(image.decode)await image.decode().catch(()=>{});
        if(request!==version||!this.isConnected)return;
        slides.forEach((slide,i)=>{slide.classList.toggle('is-active',i===index);slide.classList.toggle('is-inactive',i!==index);slide.setAttribute('aria-hidden',String(i!==index));});
        if(range){range.value=String(index+1);range.setAttribute('aria-valuetext',`${index+1} / ${count}`);scrollbar.style.setProperty('--gallery-index',index);}
      };
      controls.hidden=false;
      if(scrollbar)scrollbar.hidden=false;
      on(controls,'click',event=>{const button=event.target.closest('button');if(button)show(current+Number(button.dataset.step));});
      on(range,'input',()=>show(Number(range.value)-1));
      on(media,'keydown',event=>{
        if(event.target===range)return;
        if(event.key==='ArrowLeft'||event.key==='ArrowRight'){event.preventDefault();show(current+(event.key==='ArrowRight'?1:-1));}
      });
      on(link,'pointerdown',event=>{
        if(event.pointerType==='mouse'||!event.isPrimary)return;
        start={x:event.clientX,y:event.clientY,id:event.pointerId};
        link.setPointerCapture(event.pointerId);
      });
      on(link,'pointercancel',()=>{start=null;});
      on(link,'pointerup',event=>{
        if(!start||start.id!==event.pointerId)return;
        const dx=event.clientX-start.x,dy=event.clientY-start.y;start=null;
        if(Math.abs(dx)>32&&Math.abs(dx)>Math.abs(dy)*1.4){show(current+(dx<0?1:-1));suppressUntil=performance.now()+450;}
      });
      on(link,'click',event=>{if(event.detail&&performance.now()<suppressUntil)event.preventDefault();});
    }
  });
}
{% endjavascript %}
