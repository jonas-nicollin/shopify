{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}


{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
{%- endunless -%}

{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if section.settings.quick_add == 'bulk' -%}
  <script src="{{ 'quick-add-bulk.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-order-list.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<product-catalog class="catalog-grid{% if section.settings.full_width %} catalog-grid--full-width{% endif %} section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}" data-section="{{ section.id }}" data-sticky="{{ section.settings.sticky_filters }}" data-count="{{ section.settings.show_product_count }}" data-pagination="{{ section.settings.enable_pagination }}" data-autoplay="{{ section.settings.editorial_video_autoplay }}" style="--catalog-mobile:{{ section.settings.columns_mobile }};--catalog-desktop:{{ section.settings.columns_desktop }};--catalog-span:{{ section.settings.columns_desktop | at_most: 2 }}">
  {% render 'collection-context', menu: section.settings.navigation_menu, mode: 'navigation', current_collection: collection %}
  {%- paginate collection.products by section.settings.products_per_page -%}
    <div class="catalog-grid__layout{% if section.settings.filter_type == 'vertical' %} facets-vertical{% endif %} page-width">
      {{ 'component-facets.css' | asset_url | stylesheet_tag }}
      {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
        <aside class="facets-wrapper" id="main-collection-filters" data-id="{{ section.id }}" aria-label="{{ 'products.facets.filter_and_sort' | t | escape }}">
          {% capture filters_markup %}
            {% render 'facets', results: collection, enable_filtering: section.settings.enable_filtering, enable_sorting: section.settings.enable_sorting, filter_type: section.settings.filter_type, paginate: paginate %}
          {% endcapture %}
          {{ filters_markup | replace: 'facet-filters-form', 'catalog-filters-form' | replace: 'facet-remove', 'catalog-filter-remove' | replace: '<price-range', '<catalog-price-range' | replace: '</price-range', '</catalog-price-range' | replace: 'scroll-trigger animate--fade-in', '' }}
          {% if section.settings.filter_type == 'vertical' and section.settings.enable_sorting %}
            <catalog-filters-form class="catalog-grid__vertical-sort small-hide">
              <form id="CatalogSort-{{ section.id }}">
                <label for="CatalogSortBy-{{ section.id }}">{{ 'products.facets.sort_by_label' | t }}</label>
                <select id="CatalogSortBy-{{ section.id }}" name="sort_by">
                  {% assign active_sort = collection.sort_by | default: collection.default_sort_by %}
                  {% for option in collection.sort_options %}<option value="{{ option.value | escape }}"{% if option.value == active_sort %} selected{% endif %}>{{ option.name | escape }}</option>{% endfor %}
                </select>
              </form>
            </catalog-filters-form>
          {% endif %}
        </aside>
      {%- endif -%}
      <div class="product-grid-container" id="ProductGridContainer">
        {% unless section.settings.enable_filtering or section.settings.enable_sorting %}<p class="catalog-grid__count">{{ 'products.facets.product_count_simple' | t: count: collection.products_count }}</p>{% endunless %}
        {% if collection.products.size == 0 %}
          <div class="collection collection--empty" id="product-grid" data-id="{{ section.id }}"><h2>{{ 'sections.collection_template.empty' | t }}</h2><a data-catalog-reset href="{{ collection.url }}">{{ 'products.facets.clear_all' | t }}</a></div>
        {% else %}
          <div class="collection">
            <ul id="product-grid" data-id="{{ section.id }}" class="grid product-grid{% if section.settings.quick_add == 'bulk' %} collection-quick-add-bulk{% endif %}" role="list">
              {% liquid
                assign skip_card_product_styles = false
                assign secondary_hover = section.settings.show_secondary_image
              %}
              {% for product in collection.products %}
                {% liquid
                  assign position = paginate.current_offset | plus: forloop.index0
                  assign remainder = position | modulo: section.settings.editorial_interval
                  assign editorial = false
                  if section.settings.enable_editorial and position > 0 and remainder == 0
                    assign editorial = true
                  endif
                  assign lazy_load = true
                  if forloop.index <= section.settings.columns_desktop
                    assign lazy_load = false
                  endif
                %}
                {% if editorial %}
                  {% liquid
                    assign media = product.images[1] | default: product.featured_image
                    assign media_path = section.settings.editorial_media_path | strip | split: '.'
                    assign override = nil
                    assign override_media = nil
                    if media_path.size == 2 or media_path.size == 3
                      assign override = product.metafields[media_path[0]][media_path[1]].value
                      assign override_media = override
                      if media_path.size == 3
                        assign override_media = override[media_path[2]].value
                      endif
                    endif
                    if override_media.media_type == 'image' or override_media.media_type == 'video'
                      assign media = override_media
                    endif
                    assign sequence = position | divided_by: section.settings.editorial_interval
                    assign side = sequence | modulo: 2
                    assign photo = media.preview_image | default: media
                    assign alt = override.alt.value | default: photo.alt | default: product.title
                  %}
                  {% if media != blank %}
                    <li class="catalog-grid__editorial" data-side="{{ side }}" data-product="{{ product.id }}" data-position="{{ position }}" data-catalog-item>
                      <a href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                        {% assign image_loading = 'lazy' %}{% if lazy_load == false %}{% assign image_loading = 'eager' %}{% endif %}
                        {{ photo | image_url: width: 2000 | image_tag: widths: '360,540,720,1080,1600,2000', sizes: '(min-width:990px) 50vw, 100vw', loading: image_loading, alt: alt }}
                        {% if media.media_type == 'video' %}<template data-catalog-video>{{ media | video_tag: preload: 'none', loop: true, muted: true, playsinline: true, controls: false }}</template>{% endif %}
                      </a>
                      {% if media.media_type == 'video' %}
                        <button class="catalog-grid__video-toggle" type="button" data-video-toggle aria-label="Play video: {{ product.title | escape }}" aria-pressed="false" hidden><span data-video-play>{{ 'icon-play.svg' | inline_asset_content }}</span><span data-video-pause hidden>{{ 'icon-pause.svg' | inline_asset_content }}</span></button>
                      {% endif %}
                    </li>
                  {% endif %}
                {% endif %}
                <li class="grid__item" data-catalog-item data-product="{{ product.id }}">
                  {% render 'card-product', card_product: product, media_aspect_ratio: section.settings.image_ratio, show_secondary_image: secondary_hover, show_vendor: section.settings.show_vendor, show_rating: section.settings.show_rating, lazy_load: lazy_load, skip_styles: skip_card_product_styles, quick_add: section.settings.quick_add, section_id: section.id, desktop_columns: section.settings.columns_desktop, mobile_columns: section.settings.columns_mobile %}
                </li>
                {% assign skip_card_product_styles = true %}
              {% endfor %}
            </ul>
            {% if section.settings.enable_pagination %}
              {% if paginate.pages > 1 %}{% render 'pagination', paginate: paginate, anchor: '' %}{% endif %}
            {% elsif paginate.next %}
              <div class="catalog-grid__pagination"><a class="button button--secondary" data-catalog-next href="{{ paginate.next.url | escape }}">{{ 'general.pagination.next' | t }}</a></div>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
    <span class="visually-hidden" data-catalog-status role="status" aria-live="polite"></span>
  {% endpaginate %}
</product-catalog>

{% stylesheet %}
.catalog-grid {display:block}
.catalog-grid__layout {position:relative}
.catalog-grid--full-width > .catalog-grid__layout {max-width:none;padding-inline:1.5rem}
@media(min-width:750px) and (max-width:989px){.catalog-grid--full-width > .catalog-grid__layout {padding-inline:5rem}}
.shopify-section:has(.catalog-grid .mobile-facets__disclosure[open]) {position:relative;z-index:100}
.catalog-grid .facets-wrapper {background:rgb(var(--color-background));align-self:start}
@media(max-width:749px){
  .catalog-grid:is([data-sticky="mobile"],[data-sticky="both"]) .facets-wrapper {position:sticky;top:var(--catalog-top,0px);z-index:2}
}
@media(min-width:750px){
  .catalog-grid:is([data-sticky="desktop"],[data-sticky="both"]) .facets-wrapper {position:sticky;top:var(--catalog-top,0px);z-index:2}
  .catalog-grid .facets-vertical .facets-wrapper {max-height:calc(100dvh - var(--catalog-top,0px));overflow-y:auto}
  .catalog-grid .facets-wrapper:has(.mobile-facets__disclosure[open]) {overflow:visible}
}
.catalog-grid catalog-filters-form {display:block}
.catalog-grid catalog-price-range {display:flex}
.catalog-grid .facets__header catalog-filter-remove {margin-left:auto}
.catalog-grid .active-facets catalog-filter-remove:only-child {display:none}
.catalog-grid .mobile-facets__close {z-index:101}
.catalog-grid .mobile-facets__wrapper {z-index:4}
.catalog-grid__vertical-sort {margin-top:2rem}
.catalog-grid__vertical-sort select {width:100%;padding:1rem;background:transparent;color:inherit;border:1px solid currentColor}
.catalog-grid[data-count="false"] :is(.product-count,.product-count-vertical,.mobile-facets__count,.catalog-grid__count) {display:none!important}
.catalog-grid[aria-busy="true"] #ProductGridContainer {opacity:.55;pointer-events:none}
.catalog-grid #ProductGridContainer {transition:opacity 220ms ease;min-width:0}
.catalog-grid .product-grid {display:grid;grid-template-columns:repeat(var(--catalog-mobile),minmax(0,1fr));grid-auto-flow:row dense}
@media(min-width:990px){.catalog-grid .product-grid {grid-template-columns:repeat(var(--catalog-desktop),minmax(0,1fr))}}
.catalog-grid .product-grid > li {width:auto;max-width:none;min-width:0;isolation:isolate}
.catalog-grid img[data-catalog-reveal] {animation:catalog-media-reveal 650ms cubic-bezier(.2,.65,.3,1) both}
@keyframes catalog-media-reveal {from {opacity:0} to {opacity:1}}
@media(prefers-reduced-motion:reduce){.catalog-grid img[data-catalog-reveal] {animation:none}}
.catalog-grid .catalog-grid__editorial {position:relative;grid-column:1/-1;overflow:hidden;aspect-ratio:3/4;background:rgba(var(--color-foreground),.03)}
@media(min-width:990px){
  .catalog-grid .catalog-grid__editorial {grid-column:span var(--catalog-span);grid-row:span 2;aspect-ratio:auto;min-height:200px}
  .catalog-grid .catalog-grid__editorial[data-side="0"] {grid-column:calc(-1 - var(--catalog-span))/-1}
}
.catalog-grid__editorial > a,.catalog-grid__editorial img,.catalog-grid__editorial video {display:block;width:100%;height:100%}
.catalog-grid__editorial > a {position:absolute;inset:0}
.catalog-grid__editorial img,.catalog-grid__editorial video {object-fit:cover}
.catalog-grid__editorial video {position:absolute;inset:0}
.catalog-grid__video-toggle {position:absolute;inset:auto 1rem 1rem auto;z-index:1;width:44px;height:44px;border:0;background:rgba(var(--color-background),.85);color:rgb(var(--color-foreground));cursor:pointer}
.catalog-grid__video-toggle svg {width:14px;height:14px}
.catalog-grid__video-toggle [hidden] {display:none}
.catalog-grid[data-pagination="true"] .pagination__list {display:flex}
.catalog-grid__pagination {text-align:center;margin:2rem auto}
.catalog-grid__pagination [aria-busy="true"] {opacity:.5;pointer-events:none}
@media(prefers-reduced-motion:reduce){.catalog-grid #ProductGridContainer {transition:none}}
{% endstylesheet %}

{% javascript %}
if (!customElements.get('product-catalog')) {
  customElements.define('product-catalog', class extends HTMLElement {
    connectedCallback() { this.frame = requestAnimationFrame(() => this.mount()); }
    disconnectedCallback() {
      cancelAnimationFrame(this.frame); cancelAnimationFrame(this.offsetFrame); clearTimeout(this.timer);
      this.events?.abort(); this.request?.abort(); this.pageRequest?.abort();
      this.mediaObserver?.disconnect(); this.pageObserver?.disconnect(); this.videoObserver?.disconnect(); this.resize?.disconnect();
      document.body.classList.remove('overflow-hidden-mobile','overflow-hidden-tablet');
    }
    mount() {
      this.events = new AbortController();
      const on = (target, type, fn, options = {}) => target.addEventListener(type,fn,{...options,signal:this.events.signal});
      // Own Apply/close intent before Dawn's inline handler and any pending filter response.
      on(this,'click',event => {
        const drawer=event.target.closest('menu-drawer');
        if(!drawer)return;
        const details=drawer.querySelector('.mobile-facets__disclosure');
        const summary=details?.querySelector('summary');
        if(event.target.closest('.mobile-facets__footer button,.mobile-facets__close')){
          event.preventDefault();event.stopPropagation();this.drawerClosing=true;
          drawer.closeMenuDrawer?.(event,summary);
          if(details)details.open=false;
          document.body.classList.remove('overflow-hidden-mobile','overflow-hidden-tablet');
          if(summary)summary.setAttribute('aria-expanded','false');
        } else if(event.target.closest('summary')===summary)this.drawerClosing=details.open;
      },{capture:true});
      on(this,'input',event => {
        if (!event.target.closest('catalog-filters-form')) return;
        clearTimeout(this.timer);
        this.timer = setTimeout(() => this.submitFilters(event.target.form),event.target.closest('catalog-price-range') ? 500 : 180);
      });
      on(this,'submit',event => { if(event.target.closest('catalog-filters-form')) {event.preventDefault();clearTimeout(this.timer);this.submitFilters(event.target);} });
      on(this,'click',event => {
        const remove = event.target.closest('catalog-filter-remove a,[data-catalog-reset]');
        if (remove && !event.metaKey && !event.ctrlKey) {event.preventDefault();clearTimeout(this.timer);this.renderFilters(new URL(remove.href),true);}
        const next = event.target.closest('[data-catalog-next]');
        if (next && next.dataset.retry !== 'true' && !event.metaKey && !event.ctrlKey) {event.preventDefault();this.loadNext(next);}
        const toggle = event.target.closest('[data-video-toggle]');
        if (toggle) {const tile=toggle.closest('[data-catalog-item]');const video=tile.querySelector('video');if(video){video.dataset.userPaused=String(!video.paused);video.paused?video.play().catch(()=>{}):video.pause();}}
      });
      on(this,'keydown',event => {
        if(event.key !== 'Escape' || event.target.closest('menu-drawer')) return;
        const details=event.target.closest('details[open]');if(details){details.open=false;details.querySelector('summary')?.focus();}
      });
      on(window,'popstate',() => this.renderFilters(new URL(location.href),false));
      on(document,'visibilitychange',() => this.querySelectorAll('video').forEach(video=>{if(document.hidden)video.pause();}));
      const bars = [...document.querySelectorAll('.section-header,.announcement-bar-section,.breadcrumbs-section--sticky')];
      const offset = () => {
        this.offsetFrame=0;let top=0;
        for(const {el,rect} of bars.map(el=>({el,rect:el.getBoundingClientRect()})).sort((a,b)=>a.rect.top-b.rect.top)) {
          if(['sticky','fixed'].includes(getComputedStyle(el).position)&&rect.top<=top+1&&rect.bottom>top)top=rect.bottom;
        }
        this.style.setProperty('--catalog-top',top+'px');
      };
      const queue = () => {if(!this.offsetFrame)this.offsetFrame=requestAnimationFrame(offset);};
      if('ResizeObserver' in window){this.resize=new ResizeObserver(queue);bars.forEach(el=>this.resize.observe(el));}
      ['scroll','resize','transitionend'].forEach(type=>on(window,type,queue,{passive:true}));
      offset();this.observeContent();
    }
    submitFilters(form) {
      if(!form || !this.contains(form))return;
      for(const range of form.querySelectorAll('catalog-price-range')){
        const [min,max]=range.querySelectorAll('input');
        for(const input of [min,max]){
          if(!input||input.value==='')continue;
          const value=Number(input.value),limit=Number(input.dataset.max);
          if(Number.isFinite(value))input.value=String(Math.max(0,Number.isFinite(limit)?Math.min(limit,value):value));
        }
        if(min&&max&&min.value&&max.value&&Number(min.value)>Number(max.value))max.value=min.value;
      }
      const mobile=form.id==='FacetFiltersFormMobile';
      const forms=mobile?[form]:[...this.querySelectorAll('catalog-filters-form form')].filter(item=>item.id!=='FacetFiltersFormMobile');
      const url=new URL(location.href);url.search='';
      forms.forEach(item=>new FormData(item).forEach((value,key)=>{if(value!=='')url.searchParams.append(key,value);}));
      this.renderFilters(url,true);
    }
    async fetchSection(url,signal) {
      const requestURL=new URL(url);requestURL.searchParams.set('section_id',this.dataset.section);
      const result=await fetch(requestURL,{signal});if(!result.ok)throw new Error('Section unavailable');
      const page=new DOMParser().parseFromString(await result.text(),'text/html');
      const section=page.querySelector('product-catalog');if(!section)throw new Error('Section missing');return section;
    }
    async renderFilters(url,push) {
      this.request?.abort();this.pageRequest?.abort();this.request=new AbortController();
      const controller=this.request;this.setAttribute('aria-busy','true');
      try {
        const section=await this.fetchSection(url,controller.signal);if(controller.signal.aborted||!this.isConnected)return;
        // Read state at completion so closing the mobile drawer during a request stays respected.
        const focus=document.activeElement?.id;
        const opened=[...this.querySelectorAll('details[open][id]')].filter(el=>!this.drawerClosing||!el.closest('menu-drawer')).map(el=>({id:el.id,submenu:el.classList.contains('menu-opening')}));
        const oldDrawer=this.querySelector('menu-drawer');
        const drawerOpen=!this.drawerClosing&&!!oldDrawer?.querySelector('details[open]');
        const drawerScroll=oldDrawer?.querySelector('.mobile-facets__main')?.scrollTop||0;
        this.mediaObserver?.disconnect();this.pageObserver?.disconnect();this.videoObserver?.disconnect();
        this.innerHTML=section.innerHTML;
        opened.forEach(({id,submenu})=>{const el=this.querySelector('#'+CSS.escape(id));if(el){el.open=true;if(submenu){el.classList.add('menu-opening');el.closest('.has-submenu')?.classList.add('submenu-open');el.querySelector('summary')?.setAttribute('aria-expanded','true');}}});
        if(drawerOpen){
          const drawer=this.querySelector('menu-drawer');const details=drawer?.querySelector('details');
          if(details){details.open=true;details.classList.add('menu-opening');details.querySelector('summary')?.setAttribute('aria-expanded','true');drawer.querySelector('.mobile-facets__main').scrollTop=drawerScroll;}
          // Dawn's menu drawer owns keyboard trapping; re-open through its public UI method.
          if(drawer?.openMenuDrawer)drawer.openMenuDrawer(drawer.querySelector('summary'));
        } else document.body.classList.remove('overflow-hidden-mobile','overflow-hidden-tablet');
        this.observeContent();
        if(push)history.pushState({},'',url.pathname+url.search);
        if(focus)this.querySelector('#'+CSS.escape(focus))?.focus({preventScroll:true});
        this.querySelector('[data-catalog-status]').textContent=this.querySelector('#ProductCount')?.textContent.trim()||'';
      } catch(error) {if(error.name!=='AbortError')location.assign(url.href);}
      finally {if(this.request===controller)this.removeAttribute('aria-busy');}
    }
    observeContent() {
      const items=[...this.querySelectorAll('[data-catalog-item]:not([data-observed])')];
      const observerSupported='IntersectionObserver' in window;
      if(observerSupported&&!this.mediaObserver)this.mediaObserver=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){this.mediaObserver.unobserve(entry.target);this.loadMedia(entry.target);}}),{rootMargin:'500px'});
      if(observerSupported&&!this.videoObserver)this.videoObserver=new IntersectionObserver(entries=>entries.forEach(entry=>{
        const video=entry.target.querySelector('video');if(!video)return;
        if(entry.isIntersecting&&this.dataset.autoplay==='true'&&!matchMedia('(prefers-reduced-motion: reduce)').matches&&video.dataset.userPaused!=='true'&&!document.hidden)video.play().catch(()=>{});else video.pause();
      }),{threshold:.15});
      items.forEach(item=>{
        item.dataset.observed='';
        // Keep Dawn's native image loading. Only animate images which finish loading later.
        item.querySelectorAll('img').forEach(image=>{
          if(!image.complete)image.addEventListener('load',()=>{image.dataset.catalogReveal='';},{once:true,signal:this.events.signal});
        });
        if(item.querySelector('[data-catalog-video]'))observerSupported?this.mediaObserver.observe(item):this.loadMedia(item);
      });
      const link=this.querySelector('[data-catalog-next]');
      if(link&&observerSupported&&this.dataset.pagination!=='true'){
        if(!this.pageObserver)this.pageObserver=new IntersectionObserver(entries=>{if(entries.some(entry=>entry.isIntersecting))this.loadNext(this.querySelector('[data-catalog-next]'));},{rootMargin:'300px'});
        this.pageObserver.observe(link);
      }
    }
    loadMedia(item) {
      if(!item.isConnected)return;
      const template=item.querySelector('[data-catalog-video]');
      if(template){
        const video=template.content.firstElementChild.cloneNode(true);video.muted=true;template.replaceWith(video);
        const button=item.querySelector('[data-video-toggle]');button.hidden=false;
        const update=()=>{button.setAttribute('aria-pressed',String(!video.paused));button.setAttribute('aria-label',video.paused?'Play video':'Pause video');button.querySelector('[data-video-play]').hidden=!video.paused;button.querySelector('[data-video-pause]').hidden=video.paused;};
        video.addEventListener('play',update,{signal:this.events.signal});video.addEventListener('pause',update,{signal:this.events.signal});update();
        this.videoObserver?.observe(item);
      }
    }
    async loadNext(link) {
      if(!link||this.pageBusy||this.hasAttribute('aria-busy'))return;
      this.pageBusy=true;this.pageObserver?.unobserve(link);link.setAttribute('aria-busy','true');
      this.pageRequest=new AbortController();const controller=this.pageRequest;
      try {
        const section=await this.fetchSection(new URL(link.href),controller.signal);if(controller.signal.aborted||!link.isConnected)return;
        const list=section.querySelector('ul#product-grid');const target=this.querySelector('ul#product-grid');
        if(!list?.children.length||!target)throw new Error('Products missing');
        target.append(...Array.from(list.children));
        const next=section.querySelector('[data-catalog-next]');
        if(next&&new URL(next.getAttribute('href'),location.href).href!==link.href)link.href=next.getAttribute('href');else link.parentElement.remove();
        this.observeContent();
      } catch(error) {if(error.name!=='AbortError')link.dataset.retry='true';}
      finally {this.pageBusy=false;link.removeAttribute('aria-busy');}
    }
  });
}
{% endjavascript %}

{% schema %}
{
  "name": "Product grid",
  "enabled_on": {
    "templates": [
      "collection"
    ]
  },
  "limit": 1,
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_pagination",
      "label": "Enable pagination",
      "default": true,
